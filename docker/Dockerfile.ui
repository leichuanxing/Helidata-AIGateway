FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ARG OPERATIONS_READY=false
ENV VITE_OPERATIONS_READY=$OPERATIONS_READY
RUN npm run build
FROM helidata-ai-gateway:stage17
COPY --from=frontend /build/dist /app/frontend
